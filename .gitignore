# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# next.js
/.next/
/out/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Local Figma API dumps (dev only)
.figma-*
figma-parse-out.txt

# MCP config có chứa Figma PAT (dùng mcp.json.example làm mẫu)
.cursor/mcp.json

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

.env.local
.env.development.local
.env.test.local
.env.production.local
.env

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem

deploy.sh

# Local release deployments
/releases/
/current
/current.new
*.tsbuildinfo
next-env.d.ts
public/robots.txt
.history
ecosystem.config.js
redirects.txt
redirects.json
.playwright-mcp
playwright-report/
test-results/
tests/
playwright.config.ts
deploy.sh
AGENTS.md
.gitnexus
.claude/
CLAUDE.md
bom.txt
warmsitemap.sh

# Local agent / IDE tooling
.cursor/
.agents/
.antigravity/
.codex
.serena/
screenshots/
# Backend log files (src/backend/libs/config/log.ts)
src/backend/storage/logs/*
src/backend/storage/payment/*
!src/backend/storage/logs/.gitkeep
# Integration storage: its log files and the BigQuery service account key
src/backend/storage/integration/*
# Firebase service account key (push notifications)
src/backend/storage/data/*

# Env file for docker compose runs
.env.docker

# Coolify environment (secrets)
.env.coolify

logs/
tmp/
# Postman collections stay local
docs/postman/
graphify-out